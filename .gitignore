# Dependencies
node_modules/
# Note: package-lock.json is tracked for consistent CI/CD builds

# Build outputs
dist/
.vite/
# Note: docs/ is NOT ignored - it's used for GitHub Pages deployment
# Note: .nojekyll is tracked to disable Jekyll processing

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local
__pycache__/
*.pyc
logs/
models/

# Exceptions: Allow TypeScript type definitions and Python source files
!src/models/
!src/models/*.ts
!public/python/
!public/python/**/*.py

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
