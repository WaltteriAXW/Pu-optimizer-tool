{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "jsx": "react-jsx",

    /* Module resolution */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path mapping */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  /* e2e and the Playwright config are checked too. Playwright only transpiles them, so
     without this they are invisible to `npm run type-check` — and e2e/fixtures.ts imports
     PYODIDE_CDN_URL from src, where a breaking change would otherwise fail at run time
     rather than at build time. */
  "include": ["src", "e2e", "playwright.config.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
