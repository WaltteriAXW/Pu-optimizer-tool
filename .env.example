# Environment Configuration Example
# Copy this file to .env and adjust values as needed

# Pyodide CDN URL
VITE_PYODIDE_CDN=https://cdn.jsdelivr.net/pyodide/v0.24.1/full/

# Feature flags
VITE_ENABLE_ML=true
VITE_DEBUG_MODE=false

# Network Retry Configuration
# Maximum number of retry attempts for network operations (default: 3)
VITE_MAX_RETRIES=3
# Base delay in milliseconds between retries (uses exponential backoff: 2s, 4s, 8s)
VITE_RETRY_DELAY=2000

# API endpoints (for future use)
# VITE_API_URL=http://localhost:3000

# Analytics (for future use)
# VITE_ANALYTICS_ID=
