# Environment Configuration Example
# Copy this file to .env and adjust values as needed

# Pyodide CDN URL
PYODIDE_CDN=https://cdn.jsdelivr.net/pyodide/v0.24.1/full/

# Feature flags
ENABLE_ML=true
DEBUG_MODE=false

# Network Retry Configuration
# Maximum number of retry attempts for network operations (default: 3)
MAX_RETRIES=3
# Base delay in milliseconds between retries (uses exponential backoff: 2s, 4s, 8s)
RETRY_DELAY=2000
